# Local secure defaults
HOST=127.0.0.1
PORT=8000
DEBUG=false
MOCK_MODE=true
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DATABASE_PATH=data/ai_svwf.sqlite3
OUTPUT_DIR=outputs

# Video provider (real integration is completed after vendor docs/key are provided)
MODEL_PROVIDER=mock
JIMENG_API_BASE_URL=
JIMENG_API_KEY=
JIMENG_API_SECRET=
JIMENG_DEFAULT_MODEL=seedance-2.0-fast
SEEDANCE_ARK_API_KEY=
SEEDANCE_ENDPOINT_ID=
KLING_API_KEY=

# Optional OpenAI-format enhancement; core workflow does not require it
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_API_STYLE=responses

# Feishu collaboration mirror
FEISHU_SYNC_MODE=dual
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_TABLE_PRODUCTS=
FEISHU_TABLE_TASKS=
FEISHU_TABLE_QA=
FEISHU_TABLE_DELIVERY=

# Accounting reference values (replace with actual vendor pricing)
BILLING_MODE=CNY
COST_PER_SECOND_CNY=0.05
CREDITS_PER_SECOND=4.0

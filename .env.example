# ==============================================================================
# AI-SVWF (AI Short Video Workflow) 环境配置模板
# 复制为 .env 并按需填入实际密钥
# ==============================================================================

# 服务端口与主机
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 运行模式: true 为高保真离线 Mock 模式（安全演示与自测），false 为直连真实即梦 API
MOCK_MODE=true

# ------------------------------------------------------------------------------
# 1. 字节跳动 即梦 (Jimeng / Seedance) 视频生成配置
# ------------------------------------------------------------------------------
# 即梦/火山引擎 API 端点与鉴权
JIMENG_API_BASE_URL=https://openspeech.bytedance.com/api/v1/video/generate
JIMENG_API_KEY=
JIMENG_API_SECRET=
JIMENG_DEFAULT_MODEL=jimeng-video-v2

# 动态成本核算配置 (交接文档 Section 13/26 刚性要求)
# 计费模式: CNY (人民币) 或 POINTS (算力积分)
BILLING_MODE=CNY
COST_PER_SECOND_CNY=0.05
CREDITS_PER_SECOND=4.0

# ------------------------------------------------------------------------------
# 2. 飞书多维表格 (Feishu Bitable) 配置 (代替数据库对接《00_管理表》)
# ------------------------------------------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书多维表格 Base App Token (如 https://my.feishu.cn/base/bascnXXXXXXXX)
FEISHU_BITABLE_APP_TOKEN=
# 四大子表 Table ID (如 tblXXXXXXXX)
FEISHU_TABLE_PRODUCTS=
FEISHU_TABLE_TASKS=
FEISHU_TABLE_QA=
FEISHU_TABLE_DELIVERY=

# ------------------------------------------------------------------------------
# 3. 存储与成片输出配置
# ------------------------------------------------------------------------------
STORAGE_MODE=local
OUTPUT_DIR=outputs
PRESET_DIR=presets
